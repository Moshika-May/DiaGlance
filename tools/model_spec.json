  {
   "id": "brfss2020",
   "source_id": "brfss2020",
   "outcome": {
    "col": "Diabetic",
    "positive": "Yes",
    "exclude_contains": [
     "pregnan",
     "during"
    ]
   }
  },
  {
   "id": "brfss2022",
   "source_id": "brfss2022",
   "validate": true,
   "outcome": {
    "col": "HadDiabetes",
    "positive": "Yes",
    "exclude_contains": [
     "pregnan",
     "during"
    ]
   }
  }
 ],
